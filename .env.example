VITE_API_BASE_URL=http://localhost:8080/api/v1
# Customer checkout uses PayHere sandbox. Do not put merchant secrets in this file.
VITE_PAYMENT_GATEWAY=PAYHERE
# Owner platform subscriptions (3-month free trial → paid plans). Set false to hide billing UI.
VITE_OWNER_SUBSCRIPTIONS=true

# Google Maps browser keys — restrict by HTTP referrer in Cloud Console. Do not commit real values.
# Referrers should include: http://localhost:5173/* and http://127.0.0.1:5173/* (plus production domains).
# Enable on the same Cloud project: Maps JavaScript API, Places API (New), Geocoding API.
# Billing must be enabled. A 403 on AutocompletePlaces usually means Places API (New) is missing
# from API restrictions or referrers do not match the Vite origin.
VITE_GOOGLE_MAPS_JS_KEY=   # Maps JavaScript API (+ Places New if using one shared key)
VITE_GOOGLE_PLACES_KEY=    # Optional alias; loadGoogleMaps falls back to this if Maps key is empty
VITE_GOOGLE_GEOCODING_KEY= # Geocoding API (address ↔ lat/lng for pins)
